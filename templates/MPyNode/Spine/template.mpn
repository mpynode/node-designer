{
  "data": {
    "class_path": "mpynode_user.Spine",
    "expression": "# Name: Re-rootable Quaternion Spine  (numpy-first port of the original MPyNode)\n# Author: Eric Vignola - eric.vignola@gmail.com\n#\n# Ported to the current MPyNode value-type contract:\n#   * matrix inputs arrive as numpy (n,4,4) row-major (translation in row 3)\n#   * vector / euler outputs are pre-sized numpy buffers (slice-assign by index)\n#   * nurbsCurve input is an MFnNurbsCurve (om), used as-is for curve queries\n#   * matrix->euler decomposition uses om.MTransformationMatrix (rotation-order exact)\n#\n# (Imports + helper functions live in the Init tab.)\n\n# ---------------------- Main ----------------------#\n\nmax_parameter = self.inputCurve.findParamFromLength(10 ** 9)\ncurrentLength = self.inputCurve.findLengthFromParam(max_parameter)\n\nif self.resetDefaultLength or not hasattr(self, 'defaultLength'):\n    self.defaultLength = currentLength\n\n# End points / tangents for out-of-range projection (om -> numpy 3-vectors)\nt0 = np.array(self.inputCurve.tangent(0, space=om.MSpace.kWorld))[:3]\nt1 = np.array(self.inputCurve.tangent(max_parameter, space=om.MSpace.kWorld))[:3]\np0 = np.array(self.inputCurve.getPointAtParam(0, space=om.MSpace.kWorld))[:3]\np1 = np.array(self.inputCurve.getPointAtParam(max_parameter, space=om.MSpace.kWorld))[:3]\n\n# Control matrices as a single (n,4,4) numpy array (row-major; translate = row 3)\nCM = np.asarray(self.controlMatrices)\ntrans = CM[:, 3, :3]\n\n# Normalized control parameters (chord-length keys)\nkeys = [0.0]\nfor i in range(len(CM)):\n    if i > 0:\n        dist = float(np.linalg.norm(trans[i] - trans[i - 1])) + keys[i - 1]\n        keys.append(dist)\nfor i in range(1, len(keys)):\n    keys[i] /= keys[-1]\n\nratio = self.defaultLength / currentLength\ndelta = (currentLength - self.defaultLength) / currentLength\n\nfor i in range(len(self.outputTranslate)):\n\n    # -- POSITION --\n    u = self.shift + self.pivot + (((((self.samples[i] * ratio + delta * self.pivot) * (1 - self.stretch)) + self.samples[i] * self.stretch) - self.pivot) * self.scale)\n    w = self.inputCurve.findParamFromLength(u * currentLength)\n\n    if u < 0:\n        self.outputTranslate[i] = (p0 + t0 * (u * currentLength))\n    elif u > 1:\n        self.outputTranslate[i] = (p1 + t1 * ((u - 1) * currentLength))\n    else:\n        self.outputTranslate[i] = np.array(self.inputCurve.getPointAtParam(w, space=om.MSpace.kWorld))[:3]\n\n    # -- ROTATION --\n    index = bl(keys, u) - 1\n    if index < 0:\n        index = 0\n    elif index == len(keys) - 1:\n        index -= 1\n\n    up0 = CM[index][self.curveUpAxis, :3]\n    up1 = CM[index + 1][self.curveUpAxis, :3]\n\n    blend = (u - keys[index]) / (keys[index + 1] - keys[index])\n    blend = max(min(blend, 1), 0)\n\n    normal = vectorSlerp(up0, up1, blend)\n    tangent = np.array(self.inputCurve.tangent(w, space=om.MSpace.kWorld))[:3]\n\n    if self.curveInvertUpAxis:\n        normal = -normal\n    if self.curveInvertAimAxis:\n        tangent = -tangent\n\n    basis = vectorToMatrix(tangent, normal, self.curveAimAxis, self.curveUpAxis)\n    e = om.MTransformationMatrix(om.MMatrix(basis.flatten().tolist())).rotation()\n    self.outputRotate[i] = np.array([e.x, e.y, e.z])\n\n    # -- SCALE --\n    if self.scaleMethod == 0:\n        s0 = np.abs(_scale_of(CM[index])) ** (1 - blend)\n        s1 = np.abs(_scale_of(CM[index + 1])) ** blend\n        self.outputScale[i] = s0 * s1\n    else:\n        if self.scaleMethod == 2:\n            blend = 1 - ((math.cos(math.radians(blend * 180)) + 1) * 0.5)\n        self.outputScale[i] = _scale_of(CM[index + 1]) * blend + _scale_of(CM[index]) * (1 - blend)\n",
    "init_source": "# Init tab \u2014 runs once per file open (not per compute()).\n# Imports + helper functions shared by the Compute expression.\n\nimport numpy as np\nimport math\nfrom bisect import bisect_left as bl\nimport maya.api.OpenMaya as om\n\n\ndef _scale_of(M4):\n    \"\"\"Per-axis scale = row-norms of the upper 3x3 (matches MTransformationMatrix.scale).\"\"\"\n    return np.linalg.norm(M4[:3, :3], axis=1)\n\n\ndef vectorToMatrix(V0, V1, aim_axis=0, up_axis=1):\n    \"\"\"Orthonormal 4x4 (numpy) from an aim (V0) and up (V1) vector.\n    Basis rows: row aim_axis = aim, row up_axis = up, row right_axis = side.\n    \"\"\"\n    V0 = V0 / np.linalg.norm(V0)\n    V1 = V1 / np.linalg.norm(V1)\n    V2 = np.cross(V1, V0); V2 = V2 / np.linalg.norm(V2)\n    V1 = np.cross(V0, V2); V1 = V1 / np.linalg.norm(V1)\n\n    right_axis = (min([aim_axis, up_axis]) - max([aim_axis, up_axis]) + min([aim_axis, up_axis])) % 3\n    flip = 0\n    if aim_axis == 0 and up_axis == 2:\n        flip = 1\n    elif aim_axis == 1 and up_axis == 0:\n        flip = 1\n    elif aim_axis == 2 and up_axis == 1:\n        flip = 1\n\n    XYZ = np.eye(4)\n    for i in range(3):\n        XYZ[aim_axis, i] = V0[i]\n        XYZ[up_axis, i] = V1[i]\n        XYZ[right_axis, i] = (0 - V2[i]) if flip else V2[i]\n    return XYZ\n\n\ndef vectorSlerp(V0, V1, weight):\n    \"\"\"Slerp between two numpy vectors.\"\"\"\n    dot = float(np.dot(V0 / np.linalg.norm(V0), V1 / np.linalg.norm(V1)))\n    dot = max(min(dot, 1), -1)\n    angle = math.acos(dot)\n    if angle == 0:\n        return V0\n    elif math.degrees(angle) == 180:\n        return V1\n    return ((V0 * math.sin((1 - weight) * angle)) + (V1 * math.sin(weight * angle))) / math.sin(angle)\n",
    "input_attrs": {
      "controlMatrices": {
        "attr_type": "matrix",
        "is_array": true,
        "order": 0
      },
      "curveAimAxis": {
        "attr_type": "enum",
        "enum_names": [
          "X",
          "Y",
          "Z"
        ],
        "is_array": false,
        "order": 1
      },
      "curveInvertAimAxis": {
        "attr_type": "enum",
        "enum_names": [
          "False",
          "True"
        ],
        "is_array": false,
        "order": 2
      },
      "curveInvertUpAxis": {
        "attr_type": "enum",
        "enum_names": [
          "False",
          "True"
        ],
        "is_array": false,
        "order": 3
      },
      "curveUpAxis": {
        "attr_type": "enum",
        "enum_names": [
          "X",
          "Y",
          "Z"
        ],
        "is_array": false,
        "order": 4
      },
      "inputCurve": {
        "attr_type": "nurbsCurve",
        "is_array": false,
        "order": 5
      },
      "pivot": {
        "attr_type": "float",
        "is_array": false,
        "order": 6
      },
      "resetDefaultLength": {
        "attr_type": "enum",
        "enum_names": [
          "False",
          "True"
        ],
        "is_array": false,
        "order": 7
      },
      "samples": {
        "attr_type": "float",
        "is_array": true,
        "order": 8
      },
      "scale": {
        "attr_type": "float",
        "default_value": 1.0,
        "is_array": false,
        "order": 9
      },
      "scaleMethod": {
        "attr_type": "enum",
        "enum_names": [
          "Square Root",
          "Linear",
          "Cosine"
        ],
        "is_array": false,
        "order": 10
      },
      "shift": {
        "attr_type": "float",
        "is_array": false,
        "order": 11
      },
      "stretch": {
        "attr_type": "float",
        "default_value": 1.0,
        "is_array": false,
        "order": 12
      }
    },
    "methods_source": "from typing import Optional\n\n\nclass SetupError(Exception):\n    \"\"\"The current selection / scene state can't support setup for this node.\n    Message is user-facing (it names what to select).\"\"\"\n\n\n# --- Authoring command: build a complete spine system from a LIST OF DRIVING\n# TRANSFORMS. This is the single source of truth -- the setup (from a selection)\n# and the demo (from fabricated locators) both build THROUGH it. Given >=2\n# control transforms it: creates a degree-`degree` NURBS curve through their\n# world positions; live-drives each curve CV from a control's worldMatrix (a\n# decomposeMatrix bridge, so arbitrary / parented controls work -- the curve is\n# created at the world origin so its local space == world); feeds each control's\n# worldMatrix into controlMatrices[k] (the per-control twist / scale basis);\n# resolves the sample params (samples=None -> equally spaced by arc length, else\n# one rider per preset u in `samples`); and creates + connects N rider\n# transforms to the per-sample outputs. ---\n@maya_command(name=\"spineBuildSystem\", undoable=True)\ndef build_system(self, transforms: list[str], n=10, degree=3,\n                 samples: Optional[list[float]] = None,\n                 aim_axis=1, up_axis=2, rider_type=\"joint\",\n                 rider_prefix=\"spineRider\"):\n    \"\"\"Wire a whole spine into THIS node from ``transforms`` (>=2 transform names\n    driving the spine, in order). ``n`` riders are spread equally along the curve\n    when ``samples`` is None, else one rider per preset u-param in ``samples``\n    (normalized arc length 0..1). ``degree`` is the NURBS curve degree (clamped\n    to len(transforms)-1 if too few controls). ``rider_type`` is\n    joint|locator|group|cube. Returns {\"curve\", \"controls\", \"riders\"}.\"\"\"\n    from maya import cmds as mc\n\n    controls = list(transforms or [])\n    if len(controls) < 2:\n        raise SetupError(\"Spine needs at least 2 driving transforms.\")\n    degree = int(degree)\n    if degree >= len(controls):\n        degree = max(1, len(controls) - 1)\n\n    name = self.get_name()\n    mc.setAttr(name + \".curveAimAxis\", int(aim_axis))\n    mc.setAttr(name + \".curveUpAxis\", int(up_axis))\n\n    # NURBS curve through the controls' current world positions.\n    pts = [tuple(mc.xform(t, query=True, worldSpace=True, translation=True)) for t in controls]\n    curve = mc.curve(degree=degree, name=\"spineCurve#\", point=pts)\n    cshape = mc.listRelatives(curve, shapes=True, fullPath=True)[0]\n    mc.connectAttr(cshape + \".worldSpace[0]\", name + \".inputCurve\", force=True)\n\n    # Live CV drive (decomposeMatrix bridge) + control twist/scale basis.\n    for k, t in enumerate(controls):\n        dm = mc.createNode(\"decomposeMatrix\", name=\"spineCvDecomp#\")\n        mc.connectAttr(t + \".worldMatrix[0]\", dm + \".inputMatrix\", force=True)\n        mc.connectAttr(dm + \".outputTranslate\",\n                       \"%s.controlPoints[%d]\" % (cshape, k), force=True)\n        mc.connectAttr(t + \".worldMatrix[0]\",\n                       \"%s.controlMatrices[%d]\" % (name, k), force=True)\n\n    # Sample params: preset list (count follows it), else equally spaced.\n    if samples is not None:\n        su = [max(0.0, min(1.0, float(u))) for u in samples]\n    elif int(n) <= 1:\n        su = [0.0]\n    else:\n        n = int(n)\n        su = [i / float(n - 1) for i in range(n)]\n\n    rgrp = mc.group(empty=True, name=\"spine_riders#\")\n    riders = []\n    for i, u in enumerate(su):\n        mc.setAttr(\"%s.samples[%d]\" % (name, i), u)\n        if rider_type == \"joint\":\n            mc.select(clear=True)              # fresh root -- never chain-parent\n            rider = mc.joint(name=rider_prefix + \"#\")\n        elif rider_type == \"group\":\n            rider = mc.group(empty=True, name=rider_prefix + \"#\")\n        elif rider_type == \"cube\":\n            rider = mc.polyCube(name=rider_prefix + \"#\", width=0.6,\n                                height=0.6, depth=0.6)[0]\n        else:\n            rider = mc.spaceLocator(name=rider_prefix + \"#\")[0]\n        rider = mc.parent(rider, rgrp)[0]\n        mc.connectAttr(\"%s.outputTranslate[%d]\" % (name, i),\n                       rider + \".translate\", force=True)\n        mc.connectAttr(\"%s.outputRotate[%d]\" % (name, i),\n                       rider + \".rotate\", force=True)\n        mc.connectAttr(\"%s.outputScale[%d]\" % (name, i),\n                       rider + \".scale\", force=True)\n        riders.append(rider)\n    return {\"curve\": curve, \"controls\": controls, \"riders\": riders}\n\n\n# Setup: select the transforms that should drive the spine (in order along the\n# spine), then Create + Run setup. Thin adapter -> the spineBuildSystem command.\n@maya_command(creates=True)\ndef setup(self, *args, **kwargs):\n    from maya import cmds as mc\n    name = self.get_name()\n    # pre-create selection snapshot (pick order), excluding this node.\n    order = [o for o in (kwargs.get(\"selection\") or mc.ls(selection=True) or []) if o != name]\n    controls = [o for o in order\n                if \"transform\" in (mc.nodeType(o, inherited=True) or [])]\n    if len(controls) < 2:\n        raise SetupError(\"Select at least 2 transforms (in order along the \" \"spine) to drive it.\")\n    return self.call_command(\n        \"spineBuildSystem\", transforms=controls,\n        n=int(kwargs.get(\"n\", 10)), degree=int(kwargs.get(\"degree\", 3)),\n        samples=kwargs.get(\"samples\", None),\n        rider_type=kwargs.get(\"rider_type\", \"joint\"))\n\n\n# Demo: fabricate four control locators up the Y axis and build the whole spine\n# through the command -- a degree-3 curve driven by the four controls with twelve\n# joints riding it, spread by equal arc length. Same command path as the setup.\n@maya_demo(label=\"Spine From Four Controls\")\ndef demo(self):\n    from maya import cmds as mc\n    name = self.get_name()\n    ctrl_pos = ((0.0, 0.0, 0.0), (1.0, 3.0, 0.0), (-1.0, 6.0, 0.0), (0.0, 9.0, 0.0))\n    cgrp = mc.group(empty=True, name=\"spine_controls#\")\n    controls = []\n    for p in ctrl_pos:\n        c = mc.spaceLocator(name=\"spineCtrl#\")[0]\n        c = mc.parent(c, cgrp)[0]\n        mc.setAttr(c + \".translate\", p[0], p[1], p[2], type=\"double3\")\n        controls.append(c)\n    self.call_command(\"spineBuildSystem\", transforms=controls, n=12, degree=3)\n    try:\n        for _panel in mc.getPanel(type=\"modelPanel\") or []:\n            _cam = mc.modelEditor(_panel, query=True, camera=True)\n            if _cam:\n                mc.viewFit(_cam, allObjects=True)\n    except Exception:\n        pass\n    return name\n\n\n@maya_test(label=\"Spine: riders climb the curve monotonically from base to tip\", digits=2)\ndef test_spine(self):\n    \"\"\"Same test passes interpreted and compiled (parity): the spine drives its\n    riders up the curve, so their Y climbs monotonically and spans a real height.\n    Builds a minimal spine THROUGH the node's own command when nothing drives it\n    yet (parity-safe: the companion command feeds self's inputs).\"\"\"\n    from maya import cmds as mc\n    from mpynode._common.methods.test_helpers import assert_true\n    name = self.get_name()\n\n    if not (mc.listConnections(name + \".inputCurve\", s=True, d=False) or []):\n        controls = []\n        for p in ((0.0, 0.0, 0.0), (0.0, 5.0, 0.0), (0.0, 10.0, 0.0)):\n            loc = mc.spaceLocator(name=\"spineTestCtrl#\")[0]\n            mc.setAttr(loc + \".translate\", p[0], p[1], p[2], type=\"double3\")\n            controls.append(loc)\n        # Call the top-level build_system() FUNCTION directly (not\n        # self.call_command(\"spineBuildSystem\"), which routes through the\n        # wrapper's command dispatcher -- absent on the compiled node's\n        # _NodeNameProxy) so the SAME test runs on BOTH the interpreted node\n        # and its C++ compile. The spineBuildSystem companion command itself\n        # still exists (the setup + demo call it); this is the same function\n        # it dispatches to, and it drives only self.get_name() + cmds.\n        build_system(self, transforms=controls, n=5,\n                     degree=2, rider_type=\"locator\")\n\n    mc.dgdirty(name + \".outputTranslate\")\n    n = mc.getAttr(name + \".outputTranslate\", size=True) or 0\n    assert_true(n >= 3, \"spine should drive at least 3 rider samples; got %d\" % n)\n\n    ys = [mc.getAttr(\"%s.outputTranslate[%d]\" % (name, i))[0][1] for i in range(n)]\n    assert_true(ys[-1] - ys[0] > 2.0,\n                \"spine should span a real height; rider Ys=%r\" % ys)\n    assert_true(all(ys[i] <= ys[i + 1] + 1e-2 for i in range(n - 1)),\n                \"rider Y should increase monotonically up the spine; Ys=%r\" % ys)\n",
    "native_type": "mPyNode",
    "node_name": "spine",
    "output_attrs": {
      "outputRotate": {
        "attr_type": "euler",
        "is_array": true,
        "order": 0
      },
      "outputScale": {
        "attr_type": "vector",
        "is_array": true,
        "order": 1
      },
      "outputTranslate": {
        "attr_type": "vector",
        "is_array": true,
        "order": 2
      }
    },
    "stored_vars": "{\"protocol\":8,\"format\":\"keyed2\",\"codec\":\"zlib\",\"has_pickle\":false,\"data_b64\":\"eJyrrgUAAXUA+Q==\"}"
  },
  "version": 2
}