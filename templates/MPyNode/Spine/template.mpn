    "metadata": {
      "authors": [
        "Eric Vignola"
      ],
      "description": "Drives a chain of riders along a B-spline it builds from a set of control matrices.",
      "license": "Copyright 2026 Eric Vignola\n\nPermission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the \"Software\"), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all copies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.",
      "version": "2.0.0"
    },
    "methods_source": "from typing import Optional\n\n\nclass SetupError(Exception):\n    \"\"\"The current selection / scene state can't support setup for this node.\n    Message is user-facing (it names what to select).\"\"\"\n\n\n_PROJECTIONS = {\"frozen\": 0, \"infinite\": 1, \"clamped\": 2}\n_MODES       = {\"all\": 0, \"flagged\": 1, \"none\": 2, \"matrix\": 3}\n\n\ndef _flat(values):\n    \"\"\"cmds.getAttr of a numeric multi returns [(v0, v1, ...)]; flatten it.\"\"\"\n    values = values or []\n    if values and isinstance(values[0], (list, tuple)):\n        return list(values[0])\n    return list(values)\n\n\ndef _set_multi(node, attr, values):\n    \"\"\"Write values[k] to node.attr[k] and drop every stale index past them.\"\"\"\n    from maya import cmds as mc\n    for k, v in enumerate(values):\n        mc.setAttr(\"%s.%s[%d]\" % (node, attr, k), v)\n    for k in mc.getAttr(\"%s.%s\" % (node, attr), multiIndices=True) or []:\n        if k >= len(values):\n            mc.removeMultiInstance(\"%s.%s[%d]\" % (node, attr, k), b=True)\n\n\ndef _snapshot_rest(name):\n    \"\"\"Rest data for Frozen and stretch: the node's own live length and control\n    keys become defaultLength / restKeys.\"\"\"\n    from maya import cmds as mc\n    mc.setAttr(name + \".defaultLength\", mc.getAttr(name + \".currentLength\"))\n    _set_multi(name, \"restKeys\", _flat(mc.getAttr(name + \".controlKeys\")))\n\n\ndef _driving_controls(name):\n    \"\"\"The transforms feeding controlMatrices, in index order.\"\"\"\n    from maya import cmds as mc\n    out = []\n    for k in mc.getAttr(name + \".controlMatrices\", multiIndices=True) or []:\n        src = mc.listConnections(\"%s.controlMatrices[%d]\" % (name, k),\n                                 source=True, destination=False) or []\n        out.append(src[0] if src else None)\n    return out\n\n\ndef _apply_driver(name, channel, controls, preset, members, matrix):\n    \"\"\"One channel (\"rotate\" / \"scale\"): mode + flags + outside matrix.\n\n    preset: all | none | ends | first | last | list | matrix. A member list\n    forces Flagged, an outside transform forces Matrix.\"\"\"\n    from maya import cmds as mc\n    preset = (preset or \"all\").lower()\n    if members:\n        preset = \"list\"\n    if matrix:\n        preset = \"matrix\"\n    c     = len(controls)\n    flags = [False] * c\n    if preset == \"ends\":\n        flags[0] = flags[-1] = True\n    elif preset == \"first\":\n        flags[0] = True\n    elif preset == \"last\":\n        flags[-1] = True\n    elif preset == \"list\":\n        for m in members or []:\n            if m not in controls:\n                raise SetupError(\"%s driver '%s' is not one of the spine's controls.\"\n                                 % (channel.capitalize(), m))\n            flags[controls.index(m)] = True\n    mode = {\"all\": 0, \"none\": 2, \"matrix\": 3}.get(preset, 1)\n    if preset == \"matrix\":\n        if not matrix or not mc.objExists(matrix):\n            raise SetupError(\"%s driver 'matrix' needs an existing transform.\"\n                             % channel.capitalize())\n        mc.connectAttr(matrix + \".worldMatrix[0]\", \"%s.%sMatrix\" % (name, channel),\n                       force=True)\n    mc.setAttr(\"%s.%sMode\" % (name, channel), mode)\n    _set_multi(name, channel + \"Flags\", flags)\n\n\ndef _display_curve(controls, degree, periodic):\n    \"\"\"A templated Maya curve that follows the controls, for looking at only:\n    it is never connected to the node.\"\"\"\n    from maya import cmds as mc\n    c   = len(controls)\n    d   = max(1, min(int(degree), c - 1))\n    pts = [tuple(mc.xform(t, query=True, worldSpace=True, translation=True)) for t in controls]\n    if periodic:\n        curve = mc.curve(degree=d, periodic=True, point=pts + pts[:d],\n                         knot=list(range(-d + 1, c + d)), name=\"spineCurve#\")\n    else:\n        curve = mc.curve(degree=d, point=pts, name=\"spineCurve#\")\n    shape = mc.listRelatives(curve, shapes=True, fullPath=True)[0]\n    ncp   = mc.getAttr(shape + \".controlPoints\", size=True)\n    for k in range(ncp):\n        dm = mc.createNode(\"decomposeMatrix\", name=\"spineCurveDecomp#\")\n        mc.connectAttr(controls[k % c] + \".worldMatrix[0]\", dm + \".inputMatrix\", force=True)\n        mc.connectAttr(dm + \".outputTranslate\", \"%s.controlPoints[%d]\" % (shape, k), force=True)\n    mc.setAttr(shape + \".overrideEnabled\", 1)\n    mc.setAttr(shape + \".overrideDisplayType\", 1)\n    return curve\n\n\n# --- Authoring command: wire a whole spine into THIS node from a list of\n# driving transforms (>= 2, >= 3 closed, in order). Each control's worldMatrix\n# feeds controlMatrices[k]: its position is a B-spline CV, its axes can drive\n# the riders' twist and its scale their scale. The node builds the curve itself\n# (no Maya curve in the evaluation). Riders are created and connected to the\n# per-sample outputs; the rest length and rest keys are captured last. ---\n@maya_command(name=\"spineBuildSystem\", undoable=True)\ndef build_system(self, transforms: list[str], n=10, degree=3,\n                 samples: Optional[list[float]] = None,\n                 aim_axis=1, up_axis=2, rider_type=\"joint\",\n                 rider_prefix=\"spineRider\", periodic=False,\n                 rotate=\"all\", scale=\"all\",\n                 rotate_controls: Optional[list[str]] = None,\n                 scale_controls:  Optional[list[str]] = None,\n                 rotate_matrix=\"\", scale_matrix=\"\",\n                 up_axes: Optional[list[int]] = None,\n                 rotate_projection=\"frozen\", scale_projection=\"frozen\",\n                 translate_projection=\"infinite\", display_curve=True):\n    \"\"\"Wire a whole spine into THIS node from ``transforms``.\n\n    ``n`` riders spread evenly by arc length when ``samples`` is None, else one\n    rider per preset u (0..1). ``rotate`` / ``scale`` pick the drivers:\n    all | none | ends | first | last, or pass ``rotate_controls`` /\n    ``scale_controls`` (a subset of ``transforms``) or ``rotate_matrix`` /\n    ``scale_matrix`` (one outside transform). ``up_axes`` gives each control's\n    up row: 0 = the rider up axis, 1-3 = +X/+Y/+Z, 4-6 = -X/-Y/-Z.\n    Projections: frozen | infinite | clamped (translate: clamped | infinite).\n    ``rider_type`` is joint|locator|group|cube. Returns\n    {\"curve\", \"controls\", \"riders\"}.\"\"\"\n    from maya import cmds as mc\n\n    controls = list(transforms or [])\n    need     = 3 if periodic else 2\n    if len(controls) < need:\n        raise SetupError(\"Spine needs at least %d driving transforms%s.\"\n                         % (need, \" for a closed curve\" if periodic else \"\"))\n    if len(set(controls)) != len(controls):\n        raise SetupError(\"Each driving transform can only appear once.\")\n    for p in (rotate_projection, scale_projection):\n        if str(p).lower() not in _PROJECTIONS:\n            raise SetupError(\"Projection must be frozen, infinite or clamped; got %r.\" % p)\n\n    name = self.get_name()\n    mc.setAttr(name + \".curveAimAxis\",     int(aim_axis))\n    mc.setAttr(name + \".curveUpAxis\",      int(up_axis))\n    mc.setAttr(name + \".degree\",           int(degree))\n    mc.setAttr(name + \".periodic\",         bool(periodic))\n    mc.setAttr(name + \".rotateProjection\", _PROJECTIONS[str(rotate_projection).lower()])\n    mc.setAttr(name + \".scaleProjection\",  _PROJECTIONS[str(scale_projection).lower()])\n    mc.setAttr(name + \".translateProjection\",\n               0 if str(translate_projection).lower() == \"clamped\" else 1)\n    for k, t in enumerate(controls):\n        mc.connectAttr(t + \".worldMatrix[0]\",\n                       \"%s.controlMatrices[%d]\" % (name, k), force=True)\n    for k in mc.getAttr(name + \".controlMatrices\", multiIndices=True) or []:\n        if k >= len(controls):\n            mc.removeMultiInstance(\"%s.controlMatrices[%d]\" % (name, k), b=True)\n    _apply_driver(name, \"rotate\", controls, rotate, rotate_controls, rotate_matrix)\n    _apply_driver(name, \"scale\", controls, scale, scale_controls, scale_matrix)\n    _set_multi(name, \"controlUpAxes\", [int(a) for a in (up_axes or [])][:len(controls)])\n\n    if samples is not None:\n        su = [float(u) for u in samples]\n        if not periodic:\n            su = [max(0.0, min(1.0, u)) for u in su]\n    elif int(n) <= 1:\n        su = [0.0]\n    elif periodic:\n        su = [i / float(n) for i in range(int(n))]\n    else:\n        su = [i / float(int(n) - 1) for i in range(int(n))]\n    _set_multi(name, \"samples\", su)\n\n    rgrp   = mc.group(empty=True, name=\"spine_riders#\")\n    riders = []\n    for i in range(len(su)):\n        if rider_type == \"joint\":\n            mc.select(clear=True)\n            rider = mc.joint(name=rider_prefix + \"#\")\n        elif rider_type == \"group\":\n            rider = mc.group(empty=True, name=rider_prefix + \"#\")\n        elif rider_type == \"cube\":\n            rider = mc.polyCube(name=rider_prefix + \"#\", width=0.6,\n                                height=0.6, depth=0.6)[0]\n        else:\n            rider = mc.spaceLocator(name=rider_prefix + \"#\")[0]\n        rider = mc.parent(rider, rgrp)[0]\n        mc.connectAttr(\"%s.outputTranslate[%d]\" % (name, i), rider + \".translate\", force=True)\n        mc.connectAttr(\"%s.outputRotate[%d]\" % (name, i),    rider + \".rotate\",    force=True)\n        mc.connectAttr(\"%s.outputScale[%d]\" % (name, i),     rider + \".scale\",     force=True)\n        riders.append(rider)\n\n    curve = _display_curve(controls, degree, periodic) if display_curve else None\n    _snapshot_rest(name)\n    return {\"curve\": curve, \"controls\": controls, \"riders\": riders}\n\n\n# Re-capture the rest pose: the current curve length and control keys become\n# the Frozen keys and the stretch reference (rail_spine rebuilt its proxy).\n@maya_command(name=\"spineResetRest\", undoable=True)\ndef reset_rest(self):\n    \"\"\"Capture the current pose as the rest pose (defaultLength, restKeys).\"\"\"\n    from maya import cmds as mc\n    name = self.get_name()\n    if any(t is None for t in _driving_controls(name)):\n        mc.warning(\"%s: controlMatrices has gaps; rest keys follow the index order.\"\n                   % name)\n    _snapshot_rest(name)\n    if not mc.getAttr(name + \".restValid\"):\n        mc.warning(\"%s: the rest data is still not valid for Frozen.\" % name)\n    return name\n\n\n# Change which controls drive twist / scale after the build, by name. Presets\n# and lists as in spineBuildSystem; an empty preset leaves that channel alone.\n@maya_command(name=\"spineSetDrivers\", undoable=True)\ndef set_drivers(self, rotate=\"\", scale=\"\",\n                rotate_controls: Optional[list[str]] = None,\n                scale_controls:  Optional[list[str]] = None,\n                rotate_matrix=\"\", scale_matrix=\"\",\n                up_axes: Optional[list[int]] = None):\n    \"\"\"Set the rotate / scale drivers of a built spine by control name.\"\"\"\n    name     = self.get_name()\n    controls = [t for t in _driving_controls(name) if t]\n    if rotate or rotate_controls or rotate_matrix:\n        _apply_driver(name, \"rotate\", controls, rotate, rotate_controls, rotate_matrix)\n    if scale or scale_controls or scale_matrix:\n        _apply_driver(name, \"scale\", controls, scale, scale_controls, scale_matrix)\n    if up_axes is not None:\n        _set_multi(name, \"controlUpAxes\", [int(a) for a in up_axes][:len(controls)])\n    return name\n\n\n# Setup: select the transforms that should drive the spine (in order along the\n# spine), then Create + Run setup. Thin adapter -> the spineBuildSystem command.\n@maya_command(creates=True)\ndef setup(self, *args, **kwargs):\n    from maya import cmds as mc\n    name  = self.get_name()\n    order = [o for o in (kwargs.get(\"selection\") or mc.ls(selection=True) or []) if o != name]\n    controls = [o for o in order\n                if \"transform\" in (mc.nodeType(o, inherited=True) or [])]\n    if len(controls) < 2:\n        raise SetupError(\"Select at least 2 transforms (in order along the \" \"spine) to drive it.\")\n    return self.call_command(\n        \"spineBuildSystem\",\n        transforms = controls,\n        n          = int(kwargs.get(\"n\", 10)),\n        degree     = int(kwargs.get(\"degree\", 3)),\n        periodic   = bool(kwargs.get(\"periodic\", False)),\n        samples    = kwargs.get(\"samples\", None),\n        rider_type = kwargs.get(\"rider_type\", \"joint\"),\n    )\n\n\ndef _demo_controls(positions, group):\n    from maya import cmds as mc\n    cgrp     = mc.group(empty=True, name=group)\n    controls = []\n    for p in positions:\n        c = mc.spaceLocator(name=\"spineCtrl#\")[0]\n        c = mc.parent(c, cgrp)[0]\n        mc.setAttr(c + \".translate\", p[0], p[1], p[2], type=\"double3\")\n        controls.append(c)\n    return controls\n\n\ndef _demo_frame():\n    from maya import cmds as mc\n    try:\n        for _panel in mc.getPanel(type=\"modelPanel\") or []:\n            _cam = mc.modelEditor(_panel, query=True, camera=True)\n            if _cam:\n                mc.viewFit(_cam, allObjects=True)\n    except Exception:\n        pass\n\n\n# Demo: four control locators up the Y axis driving twelve cubes.\n@maya_demo(label=\"Spine From Four Controls\")\ndef demo(self):\n    ctrl_pos = ((0.0, 0.0, 0.0), (1.0, 3.0, 0.0), (-1.0, 6.0, 0.0), (0.0, 9.0, 0.0))\n    controls = _demo_controls(ctrl_pos, \"spine_controls#\")\n    self.call_command(\"spineBuildSystem\", transforms=controls, n=12, degree=3,\n                      rider_type=\"cube\", display_curve=False)\n    _demo_frame()\n    return self.get_name()\n\n\n# Demo: five controls up Y; only the two ends drive the twist (the top one is\n# turned 90 degrees) and the ends plus the middle drive the scale (the middle\n# one is fattened), so the cubes twist smoothly and bulge in the middle.\n@maya_demo(label=\"Spine: Twist Ends, Squash Middle\")\ndef demo_twist_squash(self):\n    from maya import cmds as mc\n    ctrl_pos = ((0.0, 0.0, 0.0), (0.5, 2.5, 0.0), (0.0, 5.0, 0.0), (-0.5, 7.5, 0.0), (0.0, 10.0, 0.0))\n    controls = _demo_controls(ctrl_pos, \"spine_controls#\")\n    mc.setAttr(controls[-1] + \".rotateY\", 90.0)\n    mc.setAttr(controls[2] + \".scale\", 1.8, 1.0, 1.8, type=\"double3\")\n    self.call_command(\"spineBuildSystem\", transforms=controls, n=16, degree=3,\n                      rotate=\"ends\", scale_controls=[controls[0], controls[2], controls[4]],\n                      rider_type=\"cube\", display_curve=False)\n    _demo_frame()\n    return self.get_name()\n\n\n# Demo: six controls on a circle, closed (periodic) curve; rider 0 sits on the\n# first control, the rest go round the loop.\n@maya_demo(label=\"Spine: Closed Loop\")\ndef demo_closed_loop(self):\n    import math\n    ctrl_pos = [(4.0 * math.cos(2.0 * math.pi * k / 6.0), 0.0,\n                 4.0 * math.sin(2.0 * math.pi * k / 6.0)) for k in range(6)]\n    controls = _demo_controls(ctrl_pos, \"spine_controls#\")\n    self.call_command(\"spineBuildSystem\", transforms=controls, n=24, degree=3,\n                      periodic=True, rider_type=\"cube\", display_curve=False)\n    _demo_frame()\n    return self.get_name()\n\n\ndef _test_controls(positions):\n    from maya import cmds as mc\n    controls = []\n    for p in positions:\n        loc = mc.spaceLocator(name=\"spineTestCtrl#\")[0]\n        mc.setAttr(loc + \".translate\", p[0], p[1], p[2], type=\"double3\")\n        controls.append(loc)\n    return controls\n\n\ndef _test_read(name, attr, n):\n    from maya import cmds as mc\n    return [mc.getAttr(\"%s.%s[%d]\" % (name, attr, i))[0] for i in range(n)]\n\n\ndef _test_euler(name, n):\n    \"\"\"outputRotate in radians (getAttr answers in the UI angle unit).\"\"\"\n    import math\n    from maya import cmds as mc\n    k = 1.0\n    if mc.currentUnit(query=True, angle=True).startswith(\"deg\"):\n        k = math.pi / 180.0\n    return [tuple(v * k for v in e) for e in _test_read(name, \"outputRotate\", n)]\n\n\ndef _test_rows(e):\n    \"\"\"Rider rotation rows of a row-vector XYZ euler (radians).\"\"\"\n    import math\n    cx, sx = math.cos(e[0]), math.sin(e[0])\n    cy, sy = math.cos(e[1]), math.sin(e[1])\n    cz, sz = math.cos(e[2]), math.sin(e[2])\n    return ((cy * cz, cy * sz, -sy),\n            (sx * sy * cz - cx * sz, sx * sy * sz + cx * cz, sx * cy),\n            (cx * sy * cz + sx * sz, cx * sy * sz - sx * cz, cx * cy))\n\n\n@maya_test(label=\"Spine: riders climb the curve monotonically from base to tip\", digits=2)\ndef test_spine(self):\n    \"\"\"Same test passes interpreted and compiled (parity): the spine drives its\n    riders up the curve, so their Y climbs monotonically and spans a real\n    height, and the rest data matches the live curve right after the build.\n    Calls build_system() directly -- the compiled node's proxy has no command\n    dispatcher -- so the SAME test runs on both.\"\"\"\n    from maya import cmds as mc\n    from mpynode._common.methods.test_helpers import assert_true\n    name = self.get_name()\n\n    if not (mc.listConnections(name + \".controlMatrices\", s=True, d=False) or []):\n        controls = _test_controls(((0.0, 0.0, 0.0), (0.0, 5.0, 0.0), (0.0, 10.0, 0.0)))\n        build_system(self, transforms=controls, n=5, degree=2,\n                     rider_type=\"locator\", display_curve=False)\n\n    mc.dgdirty(name + \".outputTranslate\")\n    n = mc.getAttr(name + \".outputTranslate\", size=True) or 0\n    assert_true(n >= 3, \"spine should drive at least 3 rider samples; got %d\" % n)\n    ys = [p[1] for p in _test_read(name, \"outputTranslate\", n)]\n    assert_true(ys[-1] - ys[0] > 2.0, \"spine should span a real height; rider Ys=%r\" % ys)\n    assert_true(all(ys[i] <= ys[i + 1] + 1e-2 for i in range(n - 1)),\n                \"rider Y should increase monotonically up the spine; Ys=%r\" % ys)\n    length = mc.getAttr(name + \".currentLength\")\n    assert_true(length > 0.0, \"currentLength should be positive; got %r\" % length)\n    assert_true(abs(mc.getAttr(name + \".defaultLength\") - length) < 1e-9,\n                \"the build should capture the rest length\")\n    assert_true(bool(mc.getAttr(name + \".restValid\")), \"the build should leave valid rest data\")\n\n\n@maya_test(label=\"Spine: rotate / scale drivers (none, one, matrix, ends)\", digits=2)\ndef test_spine_drivers(self):\n    \"\"\"None -> identity rotation and unit scale; one scale driver -> that scale\n    everywhere; Matrix -> one outside up vector for every rider; 'ends' -> the\n    tip rider takes the tip control's up.\"\"\"\n    from maya import cmds as mc\n    from mpynode._common.methods.test_helpers import assert_true\n    name     = self.get_name()\n    controls = _test_controls(((0.0, 0.0, 0.0), (1.0, 3.0, 0.0), (0.0, 6.0, 0.0), (-1.0, 9.0, 0.0)))\n    mc.setAttr(controls[1] + \".scale\", 2.0, 0.5, 1.5, type=\"double3\")\n    mc.setAttr(controls[-1] + \".rotateY\", 90.0)\n    build_system(self, transforms=controls, n=6, degree=3, aim_axis=1, up_axis=2,\n                 rotate=\"none\", scale_controls=[controls[1]], rider_type=\"locator\",\n                 display_curve=False)\n    n = 6\n    for e in _test_euler(name, n):\n        assert_true(max(abs(v) for v in e) < 1e-9, \"rotate none should give identity; got %r\" % (e,))\n    for s in _test_read(name, \"outputScale\", n):\n        assert_true(max(abs(a - b) for a, b in zip(s, (2.0, 0.5, 1.5))) < 1e-6,\n                    \"one scale driver should scale every rider alike; got %r\" % (s,))\n\n    up_obj = mc.spaceLocator(name=\"spineTestUp#\")[0]\n    mc.setAttr(up_obj + \".rotateY\", 90.0)  # its Z row points along +X\n    set_drivers(self, rotate=\"matrix\", rotate_matrix=up_obj)\n    for e in _test_euler(name, n):\n        z = _test_rows(e)[2]\n        assert_true(z[0] > 0.8, \"Matrix mode should take the outside up (+X); got row %r\" % (z,))\n\n    set_drivers(self, rotate=\"ends\")\n    tip  = _test_rows(_test_euler(name, n)[-1])\n    ctrl = mc.xform(controls[-1], query=True, worldSpace=True, matrix=True)\n    up   = ctrl[8:11]  # the tip control's Z row\n    dot  = sum(a * b for a, b in zip(tip[2], up))\n    assert_true(dot > 0.9, \"the tip rider should follow the tip control's up; dot=%.3f\" % dot)\n\n\n@maya_test(label=\"Spine: projections past the end drivers (Frozen / Infinite / Clamped)\", digits=2)\ndef test_spine_projections(self):\n    \"\"\"Five controls on a line, twist drivers on controls 1 and 3 (0 and 90\n    degrees): Clamped holds the end drivers, Frozen and Infinite extrapolate\n    past them, and Frozen ignores shift.\"\"\"\n    import math\n    from maya import cmds as mc\n    from mpynode._common.methods.test_helpers import assert_true\n    name     = self.get_name()\n    controls = _test_controls([(0.0, 3.0 * k, 0.0) for k in range(5)])\n    mc.setAttr(controls[3] + \".rotateY\", 90.0)\n    samples = [0.1, 0.5, 0.9]\n    build_system(self, transforms=controls, samples=samples, degree=3, aim_axis=1,\n                 up_axis=2, rotate_controls=[controls[1], controls[3]], scale=\"none\",\n                 rider_type=\"locator\", display_curve=False)\n\n    def twist():\n        out = []\n        for e in _test_euler(name, 3):\n            z = _test_rows(e)[2]\n            out.append(math.degrees(math.atan2(z[0], z[2])))\n        return out\n\n    mc.setAttr(name + \".rotateProjection\", 2)\n    clamped = twist()\n    assert_true(abs(clamped[0]) < 1.0 and abs(clamped[2] - 90.0) < 1.0,\n                \"Clamped should hold 0 / 90 past the drivers; got %r\" % clamped)\n    mc.setAttr(name + \".rotateProjection\", 0)\n    frozen = twist()\n    assert_true(abs(frozen[0] + 27.0) < 3.0 and abs(frozen[2] - 117.0) < 3.0,\n                \"Frozen should extend past the drivers (about -27 / 117); got %r\" % frozen)\n    mc.setAttr(name + \".shift\", 0.05)\n    shifted = twist()\n    assert_true(max(abs(a - b) for a, b in zip(frozen, shifted)) < 1e-6,\n                \"Frozen twist should ignore shift; got %r vs %r\" % (frozen, shifted))\n    mc.setAttr(name + \".rotateProjection\", 1)\n    infinite = twist()\n    assert_true(abs(infinite[1] - frozen[1]) > 1.0,\n                \"Infinite should follow the shifted riders; got %r vs %r\" % (infinite, frozen))\n\n\n@maya_test(label=\"Spine: closed curve registers u=0 on control 0; frames are right-handed\", digits=2)\ndef test_spine_periodic_and_frames(self):\n    \"\"\"A square loop: rider u=0 sits at (P3 + 4 P0 + P1) / 6 for degree 3, and\n    every aim / up pair gives a right-handed frame whose aim follows the curve.\"\"\"\n    from maya import cmds as mc\n    from mpynode._common.methods.test_helpers import assert_true\n    name     = self.get_name()\n    pts      = ((4.0, 0.0, 0.0), (0.0, 0.0, 4.0), (-4.0, 0.0, 0.0), (0.0, 0.0, -4.0))\n    controls = _test_controls(pts)\n    build_system(self, transforms=controls, n=8, degree=3, periodic=True,\n                 rider_type=\"locator\", display_curve=False)\n    p0   = _test_read(name, \"outputTranslate\", 1)[0]\n    want = [(pts[3][k] + 4.0 * pts[0][k] + pts[1][k]) / 6.0 for k in range(3)]\n    assert_true(max(abs(a - b) for a, b in zip(p0, want)) < 1e-6,\n                \"u=0 should register on control 0; got %r want %r\" % (p0, want))\n\n    for aim, up in ((0, 1), (0, 2), (1, 0), (1, 2), (2, 0), (2, 1)):\n        mc.setAttr(name + \".curveAimAxis\", aim)\n        mc.setAttr(name + \".curveUpAxis\", up)\n        pos = _test_read(name, \"outputTranslate\", 8)\n        for i, e in enumerate(_test_euler(name, 8)):\n            R = _test_rows(e)\n            det = (R[0][0] * (R[1][1] * R[2][2] - R[1][2] * R[2][1])\n                   - R[0][1] * (R[1][0] * R[2][2] - R[1][2] * R[2][0])\n                   + R[0][2] * (R[1][0] * R[2][1] - R[1][1] * R[2][0]))\n            assert_true(det > 0.999, \"frame should be right-handed; det=%.4f (%d,%d)\" % (det, aim, up))\n            nxt = pos[(i + 1) % 8]\n            prv = pos[(i - 1) % 8]\n            fwd = [nxt[k] - prv[k] for k in range(3)]\n            fl  = sum(v * v for v in fwd) ** 0.5\n            dot = sum(R[aim][k] * fwd[k] for k in range(3)) / fl\n            assert_true(dot > 0.95, \"aim should follow the curve; dot=%.3f (%d,%d)\" % (dot, aim, up))\n",
    "native_type": "mPyNode",
    "node_name": "spine",
    "output_attrs": {
      "controlKeys": {
        "attr_type": "double",
        "is_array": true,
        "order": 4
      },
      "currentLength": {
        "attr_type": "double",
        "is_array": false,
        "order": 3
      },
      "outputRotate": {
        "attr_type": "euler",
        "is_array": true,
        "order": 0
      },
      "outputScale": {
        "attr_type": "vector",
        "is_array": true,
        "order": 1
      },
      "outputTranslate": {
        "attr_type": "vector",
        "is_array": true,
        "order": 2
      },
      "outputWeights": {
        "attr_type": "double",
        "is_array": true,
        "order": 6
      },
      "restValid": {
        "attr_type": "bool",
        "is_array": false,
        "order": 5
      }
    },
    "stored_vars": "{\"protocol\":8,\"format\":\"keyed2\",\"codec\":\"zlib\",\"has_pickle\":false,\"data_b64\":\"eJyrrgUAAXUA+Q==\"}"
  },
  "version": 2
}