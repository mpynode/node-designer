{
  "data": {
    "class_path": "mpynode_user.Spline",
    "expression": "# Name: Spline Node  (numpy-first port)\n# Author: Eric Vignola - eric.vignola@gmail.com\n# A De Boor b-spline evaluator (arbitrary degree). cv = input vector array,\n# samples = output vector array. Node-aware of #inputs / #outputs.\n#\n# (Imports + helper functions live in the Init tab.)\n\n# -------------------------- Main --------------------------#\nc = len(self.cv)\ndegree = min(self.degree, c - 1)\n\n# Open knot vector (float array via numpy so the same source lowers to\n# deterministic C++; values match the original [0]*d + range + [c-d]*d list).\nn = len(self.samples)\nkv = np.concatenate([np.zeros(degree, dtype=np.float64),\n                     np.arange(c - degree + 1, dtype=np.float64),\n                     np.full(degree, float(c - degree), dtype=np.float64)])\n\nfor i in range(n):\n    u = float(i) / (n - 1) * float(kv[-1])\n    acc = np.zeros(3)\n    for k in range(c):\n        w = DeBoor(u, k, degree, kv)\n        acc = acc + self.cv[k] * w\n    self.samples[i] = acc\n\nif len(self.cv) > 0 and len(self.samples) > 0:\n    self.samples[-1] = self.cv[-1]\n",
    "init_source": "# Init tab \u2014 runs once per file open (not per compute()).\n# Imports + helper functions shared by the Compute expression.\n\nimport numpy as np\n\n\ndef DeBoor(u, k, d, kv):\n    # b-spline basis (Cox-de Boor recursion). kv reads are float()-wrapped and\n    # the basis test uses `and` (not bitwise &) so the same source both runs in\n    # numpy AND lowers 1:1 to deterministic C++ (nd_lower / py_to_cpp).\n    if d == 0:\n        left = float(kv[k])\n        right = float(kv[k + 1])\n        if u - left >= 0.0 and u - right < 0.0:\n            return 1.0\n        return 0.0\n\n    denom1 = float(kv[k + d]) - float(kv[k])\n    term1 = 0.0\n    if denom1 > 0.0:\n        term1 = ((u - float(kv[k])) / denom1) * DeBoor(u, k, d - 1, kv)\n\n    denom2 = float(kv[k + d + 1]) - float(kv[k + 1])\n    term2 = 0.0\n    if denom2 > 0.0:\n        term2 = ((-(u - float(kv[k + d + 1])) / denom2) * DeBoor(u, k + 1, d - 1, kv))\n\n    return term1 + term2\n",
    "input_attrs": {
      "cv": {
        "attr_type": "vector",
        "is_array": true,
        "order": 0
      },
      "degree": {
        "attr_type": "int",
        "default_value": 3,
        "is_array": false,
        "order": 1
      }
    },
    "methods_source": "# Build a complete, self-contained spline demo: a row of control locators\n# (cv -- grouped under \"<node>_controls\", zig-zagged so the curve is visibly\n# curved) AND a chain of small sample spheres placed evenly along the resulting\n# De Boor b-spline (driven by the samples output array). Drag the control\n# locators to reshape the curve; the samples follow live.\ndef demo(self):\n    from maya import cmds as mc\n    name = self.get_name()\n    mc.setAttr(name + \".degree\", 3)\n    n_ctrl, n_samp = 5, 24\n    cgrp = mc.group(empty=True, name=name + \"_controls\")\n    for j in range(n_ctrl):\n        loc = mc.spaceLocator(name=\"%s_cv%d\" % (name, j + 1))[0]\n        loc = mc.parent(loc, cgrp)[0]\n        mc.setAttr(loc + \".translateX\", float(j) * 3.0)\n        mc.setAttr(loc + \".translateY\", 4.0 if j % 2 else 0.0)   # zig-zag\n        shp = mc.listRelatives(loc, shapes=True, fullPath=True)[0]\n        mc.connectAttr(shp + \".worldPosition[0]\", name + \".cv[%d]\" % j, force=True)\n    sgrp = mc.group(empty=True, name=\"spline_samples#\")\n    for i in range(n_samp):\n        s = mc.polySphere(name=\"splineSample#\", radius=0.3)[0]\n        s = mc.parent(s, sgrp)[0]\n        mc.connectAttr(name + \".samples[%d]\" % i, s + \".translate\", force=True)\n    try:\n        for _panel in mc.getPanel(type=\"modelPanel\") or []:\n            _cam = mc.modelEditor(_panel, query=True, camera=True)\n            if _cam:\n                mc.viewFit(_cam, allObjects=True)\n    except Exception:\n        pass\n    return name\n\n\n@maya_test(label=\"Spline: b-spline endpoints match the first/last control point\", digits=3)\ndef test_spline(self):\n    \"\"\"Same test passes interpreted and compiled (parity): a De Boor b-spline\n    interpolates its endpoints, so sample[0] sits on the first CV and sample[-1]\n    on the last. Drives `self` through public plugs.\"\"\"\n    from maya import cmds as mc\n    from mpynode._common.methods.test_helpers import assert_close\n    name = self.get_name()\n\n    def _set(plug, *vals, **kw):\n        for s in (mc.listConnections(plug, s=True, d=False, plugs=True) or []):\n            mc.disconnectAttr(s, plug)\n        mc.setAttr(plug, *vals, **kw)\n\n    cvs = [(0.0, 0.0, 0.0), (3.0, 4.0, 0.0), (6.0, 0.0, 0.0),\n           (9.0, 4.0, 0.0), (12.0, 0.0, 0.0)]\n    for k, p in enumerate(cvs):\n        _set(\"%s.cv[%d]\" % (name, k), p[0], p[1], p[2], type=\"double3\")\n    _set(name + \".degree\", 3)\n\n    # Ensure sample outputs exist (reuse the demo's spheres if present).\n    n = mc.getAttr(name + \".samples\", size=True) or 0\n    if n < 6:\n        for i in range(12):\n            loc = mc.spaceLocator(name=\"splineTest#\")[0]\n            mc.connectAttr(\"%s.samples[%d]\" % (name, i), loc + \".translate\", force=True)\n        n = 12\n        mc.dgdirty(name + \".samples\")\n\n    first = mc.getAttr(\"%s.samples[0]\" % name)[0]\n    last = mc.getAttr(\"%s.samples[%d]\" % (name, n - 1))[0]\n    assert_close(list(first), list(cvs[0]),\n                 msg=\"first sample should equal the first control point\")\n    assert_close(list(last), list(cvs[-1]),\n                 msg=\"last sample should equal the last control point\")\n",
    "native_type": "mPyNode",
    "node_name": "spline",
    "output_attrs": {
      "samples": {
        "attr_type": "vector",
        "is_array": true,
        "order": 0
      }
    },
    "stored_vars": "{\"protocol\":8,\"format\":\"keyed2\",\"codec\":\"zlib\",\"has_pickle\":false,\"data_b64\":\"eJyrrgUAAXUA+Q==\"}"
  },
  "version": 2
}