{
  "data": {
    "class_path": "mpynode_user.HexAttribute",
    "expression": "# Name: Text Mesh Generator  (numpy-first port)\n# Author: Eric Vignola - eric.vignola@gmail.com\n# The `output` attribute is typed `hex`: assign plain text and the attr\n# auto-encodes it to the space-separated UTF-8 hex a Maya `type` node\n# consumes as mesh text -- no manual unicode -> hex step needed.\n\n# Convert XYZ input (a numpy 3-vector) to rounded strings.\nself.output = 'DRAG ME AROUND!\\n'\nself.output += 'X: %s\\n' % round(float(self.inPosition[0]), self.decimals)\nself.output += 'Y: %s\\n' % round(float(self.inPosition[1]), self.decimals)\nself.output += 'Z: %s\\n' % round(float(self.inPosition[2]), self.decimals)\n",
    "input_attrs": {
      "decimals": {
        "attr_type": "int",
        "default_value": 2,
        "is_array": false,
        "order": 0
      },
      "inPosition": {
        "attr_type": "vector",
        "is_array": false,
        "order": 1
      }
    },
    "methods_source": "# Build a complete, self-contained hex_attribute demo: a Maya Type text mesh\n# whose PARENT transform is the draggable control -- that transform's translate\n# feeds inPosition, and the node's hex `output` feeds the Type node, so dragging\n# the visible text updates the rendered X/Y/Z it shows. The text is extruded\n# (typeExtrude) so it has real thickness. The Type plugin is optional: if it is\n# missing a locator shape stands in under the same transform (the hex `output`\n# is still live in the Watch tab).\ndef demo(self):\n    from maya import cmds as mc\n    name = self.get_name()\n    mc.setAttr(name + \".decimals\", 2)\n    # The draggable PARENT transform -- its translate drives inPosition, and the\n    # text mesh lives under it so it moves (and re-labels) as you drag.\n    xf = mc.createNode(\"transform\", name=\"hexDragMe#\")\n    mc.setAttr(xf + \".translate\", 1.0, 2.0, 3.0, type=\"double3\")\n    mc.connectAttr(xf + \".translate\", name + \".inPosition\", force=True)\n    try:\n        if not mc.pluginInfo(\"Type\", query=True, loaded=True):\n            mc.loadPlugin(\"Type\", quiet=True)\n        type_node = mc.createNode(\"type\", name=\"hexType#\")\n        mc.connectAttr(name + \".output\", type_node + \".textInput\", force=True)\n        # Extrude the text so it reads as a solid, thick object.\n        extrude = mc.createNode(\"typeExtrude\", name=\"hexExtrude#\")\n        mc.connectAttr(type_node + \".outputMesh\", extrude + \".inputMesh\", force=True)\n        mc.connectAttr(type_node + \".vertsPerChar\", extrude + \".vertsPerChar\", force=True)\n        mc.setAttr(extrude + \".enableExtrusion\", True)\n        mc.setAttr(extrude + \".extrudeDistance\", 0.75)\n        mesh_shp = mc.createNode(\"mesh\", parent=xf, name=xf + \"Shape\")\n        mc.connectAttr(extrude + \".outputMesh\", mesh_shp + \".inMesh\", force=True)\n        mc.sets(mesh_shp, edit=True, forceElement=\"initialShadingGroup\")\n    except Exception:\n        # No Type plugin -- drop a visible locator shape under the transform so\n        # there is still something obvious to drag.\n        try:\n            mc.createNode(\"locator\", parent=xf, name=xf + \"Shape\")\n        except Exception:\n            pass\n    try:\n        for _panel in mc.getPanel(type=\"modelPanel\") or []:\n            _cam = mc.modelEditor(_panel, query=True, camera=True)\n            if _cam:\n                mc.viewFit(_cam, allObjects=True)\n    except Exception:\n        pass\n    return name\n\n\n@maya_test(label=\"Hex attr: output encodes the live X/Y/Z label text\", digits=4)\ndef test_hex_attribute(self):\n    \"\"\"Same test passes interpreted and compiled (parity): setting inPosition +\n    decimals makes the `hex` output carry the rounded X/Y/Z label. Drives `self`\n    through public plugs; decodes the space-separated UTF-8 hex back to text.\"\"\"\n    from maya import cmds as mc\n    from mpynode._common.methods.test_helpers import assert_true\n    name = self.get_name()\n\n    def _set(plug, *vals, **kw):\n        for s in (mc.listConnections(plug, s=True, d=False, plugs=True) or []):\n            mc.disconnectAttr(s, plug)\n        mc.setAttr(plug, *vals, **kw)\n\n    _set(name + \".decimals\", 2)\n    _set(name + \".inPosition\", 1.5, 2.0, 3.25, type=\"double3\")\n\n    raw = mc.getAttr(name + \".output\") or \"\"\n    # The `hex` attr stores space-separated UTF-8 hex a Maya `type` node consumes;\n    # decode it back to the label text (fall back if a build returns it decoded).\n    if \"DRAG ME\" in raw:\n        text = raw\n    else:\n        text = bytes.fromhex(raw.replace(\" \", \"\")).decode(\"utf-8\")\n\n    assert_true(\"X: 1.5\" in text, \"expected 'X: 1.5' in decoded output %r\" % text)\n    assert_true(\"Y: 2.0\" in text, \"expected 'Y: 2.0' in decoded output %r\" % text)\n    assert_true(\"Z: 3.25\" in text, \"expected 'Z: 3.25' in decoded output %r\" % text)\n",
    "native_type": "mPyNode",
    "node_name": "hexAttribute",
    "output_attrs": {
      "output": {
        "attr_type": "hex",
        "is_array": false,
        "order": 0
      }
    },
    "stored_vars": "{\"protocol\":8,\"format\":\"keyed2\",\"codec\":\"zlib\",\"has_pickle\":false,\"data_b64\":\"eJyrrgUAAXUA+Q==\"}"
  },
  "version": 2
}