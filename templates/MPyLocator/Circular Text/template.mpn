      "version": "1.0.0"
    },
    "methods_source": "# Circular Text setup: nothing to wire -- the gizmo draws from its own plugs,\n# so the demo just types a word in and frames it.\ndef demo(self):\n    from maya import cmds as mc\n\n    name = self.get_name()\n    mc.setAttr(name + \".displayText\", \"MPyNode\", type=\"string\")\n    mc.setAttr(name + \".radius\", 10.0)\n    mc.setAttr(name + \".letterHeight\", 1.6)\n    mc.setAttr(name + \".tilt\", 0.0)          # flat: read it from straight above\n    mc.setAttr(name + \".ringStyle\", 0)       # the shaded band under the word\n    try:\n        for _panel in mc.getPanel(type=\"modelPanel\") or []:\n            _cam = mc.modelEditor(_panel, query=True, camera=True)\n            if _cam:\n                mc.viewFit(_cam, allObjects=True)\n    except Exception:\n        pass\n    return name\n\n\n@maya_test(label=\"Circular text: frame, tilt, roll, taper and styles\", digits=4)\ndef test_circular_text(self):\n    \"\"\"Validate the node's INTENT through its draw buffers (a locator's only\n    output): the word centres on the aim axis and circles the up axis, `roll`\n    spins it, `tilt` rolls it from flat to upright, letters taper towards the\n    centre, `tracking` spreads them, a negative radius flips the ring, the style\n    enum switches between filled glyphs and strokes, and a long string wraps.\n\n    A COMPILED C++ locator exposes no Python ``evaluateDrawItems``, so its draw\n    buffers are unreachable here; the test then skips cleanly rather than\n    false-failing parity.\n    \"\"\"\n    import numpy as np\n    from maya import cmds as mc\n    from mpynode.wrappers.mpy_locator import MPyLocator\n    from mpynode._common.methods.test_helpers import assert_true\n\n    name = self.get_name()\n    w    = MPyLocator(name)\n\n    def setup(text=\"MPyNode\", radius=10.0, height=1.5, tilt=0.0,\n              roll=0.0, style=0, aim=2, up=1, inv_aim=0, inv_up=0,\n              tracking=1.0, alpha=1.0, ring=1):\n        mc.setAttr(name + \".displayText\", text, type=\"string\")\n        for plug, value in ((\"radius\", radius), (\"letterHeight\", height),\n                            (\"tilt\", tilt), (\"roll\", roll),\n                            (\"textStyle\", style),\n                            (\"aimAxis\", aim), (\"upAxis\", up),\n                            (\"invertAim\", inv_aim), (\"invertUp\", inv_up),\n                            (\"tracking\", tracking), (\"alpha\", alpha),\n                            (\"ringStyle\", ring)):\n            mc.setAttr(name + \".\" + plug, value)\n        out = {}\n        for c in w.evaluate_draw_commands(0.0)[\"commands\"]:\n            out.setdefault(c[\"slot\"], []).append(c[\"buffer\"])\n        return out\n\n    def glyph_points(bufs):\n        \"\"\"Every point the LETTERS drew, filled or stroked.\"\"\"\n        pts = [np.asarray(b[\"points\"], dtype=np.float64)\n               for b in bufs.get(\"polygons\", [])]\n        for b in bufs.get(\"lines\", [])[2:]:       # after the two guides\n            pts.append(np.asarray(b[\"starts\"], dtype=np.float64))\n            pts.append(np.asarray(b[\"ends\"], dtype=np.float64))\n        return np.concatenate(pts, axis=0) if pts else None\n\n    try:\n        probe = setup()\n    except Exception:\n        return\n    if not probe:\n        return\n\n    # 1) Filled by default: letters are polygons and the only lines are guides.\n    assert_true(len(probe.get(\"polygons\", [])) == 1,\n                \"the default style must draw filled glyphs\")\n    assert_true(len(probe.get(\"lines\", [])) == 2,\n                \"A-Z needs no stroke fallback (%d line buffers)\"\n                % len(probe.get(\"lines\", [])))\n\n    # 2) Flat in the ring plane and centred on the aim axis (+Z by default).\n    p = glyph_points(probe)\n    assert_true(float(np.abs(p[:, 1]).max()) < 1e-6,\n                \"tilt 0 must lay the letters flat (max |y| %.3e)\"\n                % float(np.abs(p[:, 1]).max()))\n    assert_true(float(p[:, 2].mean()) > 5.0 and abs(float(p[:, 0].mean())) < 1.5,\n                \"the word must centre on +Z (mean %.3f, %.3f)\"\n                % (float(p[:, 0].mean()), float(p[:, 2].mean())))\n\n    # 3) roll spins the word about the up axis: 90 degrees takes +Z to +X.\n    p90 = glyph_points(setup(roll=90.0))\n    assert_true(float(p90[:, 0].mean()) > 5.0\n                and abs(float(p90[:, 2].mean())) < 1.5,\n                \"roll 90 must swing the word onto +X (mean %.3f, %.3f)\"\n                % (float(p90[:, 0].mean()), float(p90[:, 2].mean())))\n\n    # 4) tilt 90 stands the letters up and removes the taper.\n    pt  = glyph_points(setup(tilt=90.0))\n    rad = np.sqrt(pt[:, 0] ** 2 + pt[:, 2] ** 2)\n    assert_true(float(pt[:, 1].max()) > 1.4,\n                \"tilt 90 must stand the letters up (max y %.3f)\"\n                % float(pt[:, 1].max()))\n    assert_true(float(np.abs(rad - 10.0).max()) < 1e-6,\n                \"upright letters must sit on the ring (max offset %.3e)\"\n                % float(np.abs(rad - 10.0).max()))\n\n    # 5) Letters are radial and taper inward. The tofu box is a rectangle in\n    #    glyph space, so on the ring its outer arc must be the wider one.\n    seg  = setup(text=chr(164))[\"lines\"][2]\n    s    = np.asarray(seg[\"starts\"], dtype=np.float64)\n    e    = np.asarray(seg[\"ends\"], dtype=np.float64)\n    lens = np.sort(np.sqrt(((e - s) ** 2).sum(axis=1)))\n    assert_true(lens.shape[0] == 4 and lens[1] > lens[0] * 1.05,\n                \"a letter's outer arc must be wider than its inner one\")\n\n    # 6) tracking spreads the word over more of the ring without resizing it.\n    def arc_span(bufs):\n        q = glyph_points(bufs)\n        return float(np.arctan2(q[:, 0], q[:, 2]).max()\n                     - np.arctan2(q[:, 0], q[:, 2]).min())\n    one, two = arc_span(setup()), arc_span(setup(tracking=2.0))\n    assert_true(two > one * 1.6,\n                \"tracking 2 must spread the word (%.3f vs %.3f rad)\"\n                % (two, one))\n\n    # 7) A negative radius flips the ring to the far side of the aim axis.\n    pn = glyph_points(setup(radius=-10.0))\n    assert_true(float(pn[:, 2].mean()) < -5.0,\n                \"a negative radius must put the word on -Z (mean z %.3f)\"\n                % float(pn[:, 2].mean()))\n\n    # 8) The axis enums move the ring: up = Z draws it in XY.\n    pz = glyph_points(setup(aim=0, up=2))\n    assert_true(float(np.abs(pz[:, 2]).max()) < 1e-6,\n                \"up = Z must draw the ring in XY (max |z| %.3e)\"\n                % float(np.abs(pz[:, 2]).max()))\n    assert_true(float(pz[:, 0].mean()) > 5.0,\n                \"aim = X must centre the word on +X\")\n    pi = glyph_points(setup(aim=0, up=2, inv_aim=1))\n    assert_true(float(pi[:, 0].mean()) < -5.0,\n                \"invertAim must centre the word on -X\")\n\n    # 9) style: lines drops the polygons, and a digit falls back to strokes\n    #    even while filled -- nothing typed disappears.\n    bl = setup(style=1)\n    assert_true(not bl.get(\"polygons\")\n                and len(bl.get(\"lines\", [])) == 3,\n                \"the lines style must draw strokes and no polygons\")\n    bd = setup(style=0, text=\"A1\")\n    assert_true(len(bd.get(\"polygons\", [])) == 1\n                and len(bd.get(\"lines\", [])) == 3,\n                \"a digit must fall back to the stroke font\")\n\n    # 9b) Tops point INWARD -- the cap ring sits inside the baseline ring --\n    #     and the word runs the way it reads: of two letters, the first is\n    #     on -X and the second on +X.\n    br     = setup(text=\"AA\")\n    g0     = np.asarray(br[\"lines\"][0][\"starts\"], dtype=np.float64)\n    g1     = np.asarray(br[\"lines\"][1][\"starts\"], dtype=np.float64)\n    r_base = float(np.sqrt(g0[:, 0] ** 2 + g0[:, 2] ** 2).mean())\n    r_cap  = float(np.sqrt(g1[:, 0] ** 2 + g1[:, 2] ** 2).mean())\n    assert_true(r_cap < r_base - 1.0,\n                \"the cap ring must sit inside the baseline ring \"\n                \"(%.3f vs %.3f)\" % (r_cap, r_base))\n    pa   = np.asarray(br[\"polygons\"][0][\"points\"],\n                      dtype=np.float64)\n    half = pa.shape[0] // 2\n    assert_true(float(pa[:half, 0].mean()) < 0.0\n                < float(pa[half:, 0].mean()),\n                \"the first letter must sit on -X and the second on +X\")\n\n    # 9c) alpha rides on the fill colour.\n    ba = setup(alpha=0.35)\n    assert_true(abs(float(ba[\"polygons\"][0][\"colors\"][3])\n                    - 0.35) < 1e-6,\n                \"alpha must reach the fill colour\")\n\n    # 9d) The shaded ring: one ribbon lofted between the guide rings, fading\n    #     from clear where the letters begin to full alpha on the far side,\n    #     and never drawn behind the text, however wide that gets.\n    def band(text=\"MPyNode\", alpha=1.0):\n        # The band draws first, in its own buffer; the letters follow it.\n        b = setup(text=text, ring=0, alpha=alpha)\n        q = np.asarray(b[\"polygons\"][0][\"points\"], dtype=np.float64)\n        v = np.asarray(b[\"polygons\"][0][\"vertex_colors\"],\n                       dtype=np.float64)\n        t = np.asarray(b[\"polygons\"][1][\"points\"], dtype=np.float64)\n        return (np.abs(np.arctan2(q[:, 0], q[:, 2])), v,\n                np.abs(np.arctan2(t[:, 0], t[:, 2])))\n\n    bth, bcol, wth = band(alpha=0.8)\n    assert_true(float(bth.min()) > float(wth.max()) + 1e-3,\n                \"the band must stop clear of the text \"\n                \"(%.4f vs %.4f rad)\" % (float(bth.min()), float(wth.max())))\n    assert_true(float(bcol[:, 3].min()) < 1e-3\n                and abs(float(bcol[:, 3].max()) - 0.8) < 1e-3,\n                \"the band must fade from clear to the alpha value \"\n                \"(%.3f..%.3f)\" % (float(bcol[:, 3].min()),\n                                 float(bcol[:, 3].max())))\n    wide = band(text=\"MPyNode MPyNode\")[0]\n    assert_true(float(wide.min()) > float(bth.min()) * 1.3,\n                \"a longer word must push the shading further out of the way\")\n\n    # 9e) `lines` draws the same gap: two faded arcs that stop short of the\n    #     text rather than two closed rings ruled straight through it.\n    bg = setup(ring=1, alpha=0.8)\n    ga = np.asarray(bg[\"lines\"][0][\"starts\"], dtype=np.float64)\n    gc = np.asarray(bg[\"lines\"][0][\"colors\"], dtype=np.float64)\n    gp = np.asarray(bg[\"polygons\"][0][\"points\"], dtype=np.float64)\n    assert_true(float(np.abs(np.arctan2(ga[:, 0], ga[:, 2])).min())\n                > float(np.abs(np.arctan2(gp[:, 0], gp[:, 2])).max()) + 1e-3,\n                \"the guide arcs must stop clear of the text\")\n    assert_true(float(gc[:, 3].min()) < 1e-3\n                and abs(float(gc[:, 3].max()) - 0.8) < 0.02,\n                \"the guide arcs must fade out at the text and reach full \"\n                \"alpha away from it (%.3f..%.3f)\"\n                % (float(gc[:, 3].min()), float(gc[:, 3].max())))\n    assert_true(float((gc[:, 3] > 0.72).mean()) > 0.6,\n                \"a thin arc must HOLD its colour and fade only at the ends, \"\n                \"not read as faint all the way round (%.2f of it is solid)\"\n                % float((gc[:, 3] > 0.72).mean()))\n\n    # 10) A long string wraps the ring instead of running past its own start.\n    pl = glyph_points(setup(text=\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\" * 3))\n    assert_true(float(pl[:, 2].min()) < -5.0,\n                \"a long string must wrap round the far side of the ring\")\n\n    # 11) Nothing animates: the gizmo asks for no idle redraws.\n    setup()\n    assert_true(w.evaluate_draw_commands(0.0)[\"auto_refresh\"] is False,\n                \"a still gizmo must not request idle redraws\")\n",
    "native_type": "mPyLocator",
    "node_name": "circularText",
    "output_attrs": {},
    "stored_vars": "{\"protocol\":8,\"format\":\"keyed2\",\"codec\":\"zlib\",\"has_pickle\":false,\"data_b64\":\"eJyrrgUAAXUA+Q==\"}"
