createNode mPyNurbsSurface -n "waveSurfSrc";
	rename -uid "E13DDD1D-F348-A5D0-DE7A-789C1AF5162D";
	addAttr -ci true -k true -sn "phase" -ln "phase" -at "float";
	addAttr -ci true -h true -sn "_initSource" -ln "_initSource" -dt "string";
	setAttr "._computeSource" -type "string" "Nu = 5\nNv = 5\nphase = float(self.phase)\ncvs = []\nfor iu in range(Nu):\n    for iv in range(Nv):\n        x = float(iu)\n        z = float(iv)\n        y = 0.5 * math.sin(x * 1.2 + phase) * math.cos(z * 1.2)\n        cvs.append([x, y, z])\nself.cvs = np.array(cvs, dtype=np.float64)\nself.num_cvs_u = Nu\nself.num_cvs_v = Nv\n";
	setAttr "._inputAttrs" -type "string" "{\"phase\":{\"attr_type\":\"float\",\"default_value\":0.0,\"is_array\":false}}";
	setAttr "._initSource" -type "string" "import math\nimport numpy as np\n";
