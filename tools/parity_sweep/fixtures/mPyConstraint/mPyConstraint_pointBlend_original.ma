	addAttr -w false -sn "outPosZ" -ln "outPosZ" -at "double" -p "outPos";
	setAttr "._computeSource" -type "string" "ax, ay, az = self.targetA[0], self.targetA[1], self.targetA[2]\nbx, by, bz = self.targetB[0], self.targetB[1], self.targetB[2]\nox, oy, oz = self.offset[0], self.offset[1], self.offset[2]\nt = self.blend\nself.outPos = (\n    ax * (1.0 - t) + bx * t + ox,\n    ay * (1.0 - t) + by * t + oy,\n    az * (1.0 - t) + bz * t + oz,\n)\n";
	setAttr "._inputAttrs" -type "string" "{\"blend\":{\"attr_type\":\"float\",\"is_array\":false,\"max_value\":1.0,\"min_value\":0.0},\"offset\":{\"attr_type\":\"vector\",\"is_array\":false},\"targetA\":{\"attr_type\":\"vector\",\"is_array\":false},\"targetB\":{\"attr_type\":\"vector\",\"is_array\":false}}";
	setAttr "._outputAttrs" -type "string" "{\"outPos\":{\"attr_type\":\"vector\",\"is_array\":false}}";
	setAttr -k on ".targetB" -type "double3" 10 0 0 ;
	setAttr -k on ".offset" -type "double3" 0 5 0 ;
	setAttr -k on ".blend" 0.25;
