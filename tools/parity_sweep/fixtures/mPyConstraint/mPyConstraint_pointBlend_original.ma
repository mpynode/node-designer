	addAttr -ci true -k true -sn "offsetZ" -ln "offsetZ" -at "double" -p "offset";
	addAttr -ci true -k true -sn "blend" -ln "blend" -min 0 -max 1 -at "float";
	addAttr -w false -sn "outPos" -ln "outPos" -at "double3" -nc 3;
	addAttr -w false -sn "outPosX" -ln "outPosX" -at "double" -p "outPos";
