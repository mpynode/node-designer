createNode mPyIkSolver -n "twoBoneSolver";
	rename -uid "C4ACAFF0-E24C-2C34-E79C-5F806420EFE4";
	addAttr -ci true -h true -sn "_initSource" -ln "_initSource" -dt "string";
	setAttr "._computeSource" -type "string" (
		"B1 = 5.0\nB2 = 5.0\nhip_wp = self.joints[0][\"world_position\"]\ntarget = self.end_effector\ndelta = target - hip_wp\nd = float(np.linalg.norm(delta))\nif d >= B1 + B2:\n    bend = 0.0\nelif d <= abs(B1 - B2):\n    bend = math.pi\nelse:\n    cos_int = (B1 ** 2 + B2 ** 2 - d ** 2) / (2.0 * B1 * B2)\n    cos_int = max(-1.0, min(1.0, cos_int))\n    bend = math.pi - math.acos(cos_int)\nself.joint_rotations[1] = [-math.degrees(bend), 0.0, 0.0]\nankle_local = np.array([0.0, -B1 - B2 * math.cos(bend), B2 * math.sin(bend)])\nif d > 1e-6:\n    a_n = ankle_local / np.linalg.norm(ankle_local)\n    t_n = delta / d\n    cos_a = float(np.clip(np.dot(a_n, t_n), -1.0, 1.0))\n    angle = math.acos(cos_a)\n    if abs(angle) < 1e-6:\n        self.joint_rotations[0] = [0.0, 0.0, 0.0]\n    else:\n        axis = np.cross(a_n, t_n)\n        axis_norm = np.linalg.norm(axis)\n        if axis_norm < 1e-6:\n            axis = np.array([1.0, 0.0, 0.0])\n        else:\n            axis = axis / axis_norm\n        c_, s_ = math.cos(angle), math.sin(angle)\n        K = np.array([[0.0, -axis[2], axis[1]],\n"
		+ "                      [axis[2], 0.0, -axis[0]],\n                      [-axis[1], axis[0], 0.0]])\n        R = np.eye(3) + s_ * K + (1.0 - c_) * (K @ K)\n        sy = math.sqrt(R[2][1] ** 2 + R[2][2] ** 2)\n        if sy > 1e-6:\n            rx = math.atan2(R[2][1], R[2][2])\n            ry = math.atan2(-R[2][0], sy)\n            rz = math.atan2(R[1][0], R[0][0])\n        else:\n            rx = math.atan2(-R[1][2], R[1][1])\n            ry = math.atan2(-R[2][0], sy)\n            rz = 0.0\n        self.joint_rotations[0] = [math.degrees(rx), math.degrees(ry), math.degrees(rz)]\nself.joint_rotations[2] = [0.0, 0.0, 0.0]\n");
	setAttr "._solverContextSnapshot" -type "string" "{\"handle\":\"legHandle\",\"joints\":[{\"name\":\"hip\",\"world_position\":[0.0,5.0,0.0],\"rotation\":[0.0,0.0,0.0]},{\"name\":\"knee\",\"world_position\":[0.0,0.0,0.0],\"rotation\":[-0.0,0.0,0.0]},{\"name\":\"ankle\",\"world_position\":[0.0,-5.0,0.0],\"rotation\":[0.0,0.0,0.0]}],\"end_effector\":[3.0,0.0,2.0],\"pole_vector\":[0.0,0.0,1.0],\"twist\":0.0}";
	setAttr "._initSource" -type "string" "import math\nimport numpy as np\n";
