createNode mPyTransform -n "bobXform";
	rename -uid "2B82200D-BA4A-598F-8CDD-DC8FC54F3FC0";
	addAttr -ci true -h true -sn "_initSource" -ln "_initSource" -dt "string";
	setAttr "._computeSource" -type "string" "m = np.eye(4)\nm[3, 0] = self.translate[0]\nm[3, 1] = self.translate[1] + 2.0 * np.sin(self.translate[0] * 0.5)\nm[3, 2] = self.translate[2]\nself.local_matrix = m\nself.apply_rotate = False\nself.apply_scale = False\n";
