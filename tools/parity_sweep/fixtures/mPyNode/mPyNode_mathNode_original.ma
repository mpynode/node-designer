createNode mPyNode -n "mathNode";
	rename -uid "898D8FA1-9A4B-D9A9-8569-87B07B96F733";
	addAttr -ci true -k true -sn "a" -ln "a" -at "float";
	addAttr -ci true -k true -sn "b" -ln "b" -at "float";
	addAttr -ci true -k true -sn "k" -ln "k" -at "float";
	addAttr -ci true -k true -sn "v" -ln "v" -at "double3" -nc 3;
	addAttr -ci true -k true -sn "vX" -ln "vX" -at "double" -p "v";
	addAttr -ci true -k true -sn "vY" -ln "vY" -at "double" -p "v";
	addAttr -ci true -k true -sn "vZ" -ln "vZ" -at "double" -p "v";
	addAttr -w false -sn "total" -ln "total" -at "float";
	addAttr -w false -sn "vsum" -ln "vsum" -at "double3" -nc 3;
	addAttr -w false -sn "vsumX" -ln "vsumX" -at "double" -p "vsum";
	addAttr -w false -sn "vsumY" -ln "vsumY" -at "double" -p "vsum";
	addAttr -w false -sn "vsumZ" -ln "vsumZ" -at "double" -p "vsum";
	addAttr -w false -sn "vlen" -ln "vlen" -at "float";
	setAttr "._computeSource" -type "string" "a = self.a\nb = self.b\nk = self.k\nvx, vy, vz = self.v[0], self.v[1], self.v[2]\nself.total = a * b + k\nself.vsum = (vx + a, vy + b, vz + k)\nself.vlen = (vx * vx + vy * vy + vz * vz) ** 0.5\n";
	setAttr "._inputAttrs" -type "string" "{\"a\":{\"attr_type\":\"float\",\"is_array\":false},\"b\":{\"attr_type\":\"float\",\"is_array\":false},\"k\":{\"attr_type\":\"float\",\"is_array\":false},\"v\":{\"attr_type\":\"vector\",\"is_array\":false}}";
	setAttr "._outputAttrs" -type "string" "{\"total\":{\"attr_type\":\"float\",\"is_array\":false},\"vlen\":{\"attr_type\":\"float\",\"is_array\":false},\"vsum\":{\"attr_type\":\"vector\",\"is_array\":false}}";
	setAttr -k on ".a" 3;
	setAttr -k on ".b" 4;
	setAttr -k on ".k" 5;
	setAttr -k on ".v" -type "double3" 1 2 2 ;
