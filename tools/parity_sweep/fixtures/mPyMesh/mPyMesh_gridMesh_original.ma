	rename -uid "A022980E-C94F-2412-907B-B38968481C03";
	setAttr ".g" yes;
createNode mPyMesh -n "gridMeshSrc";
	rename -uid "2C37E2E3-584F-2E21-3734-6BBC5EF264D3";
	addAttr -ci true -k true -sn "phase" -ln "phase" -at "float";
	addAttr -ci true -h true -sn "_initSource" -ln "_initSource" -dt "string";
	setAttr "._computeSource" -type "string" "R = 4\nphase = float(self.phase)\npts = []\nfor i in range(R + 1):\n    for j in range(R + 1):\n        x = float(i)\n        z = float(j)\n        y = 0.3 * math.sin(x + phase)\n        pts.append([x, y, z])\nself.points = np.array(pts, dtype=np.float64)\ncounts = []\nindices = []\nfor i in range(R):\n    for j in range(R):\n        a = i * (R + 1) + j\n        counts.append(4)\n        indices.extend([a, a + 1, a + (R + 1) + 1, a + (R + 1)])\nself.counts = np.array(counts, dtype=np.int32)\nself.indices = np.array(indices, dtype=np.int32)\n";
	setAttr "._inputAttrs" -type "string" "{\"phase\":{\"attr_type\":\"float\",\"default_value\":0.0,\"is_array\":false}}";
	setAttr "._initSource" -type "string" "import math\nimport numpy as np\n";
createNode script -n "uiConfigurationScriptNode";
	rename -uid "C3C3FCB9-2E48-679E-A96F-D093B2B9D78C";
	setAttr ".b" -type "string" "// Maya Mel UI Configuration File.\n// No UI generated in batch mode.\n";
